# LibreGrades — copy to .env and configure before first run

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DISTRICT_NAME=Sample Unified School District
# Optional: fixed 6-digit server ID (only applied on first install if unset)
# SERVER_CODE=482910

# Database — Docker Compose uses host "db" (only works inside containers)
POSTGRES_DB=libregrades
POSTGRES_USER=libregrades
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgres://libregrades:change-me-db-password@db:5432/libregrades

# Local dev on your PC (optional): uncomment to use local Postgres instead of SQLite auto-fallback
# LOCAL_DATABASE_URL=postgres://libregrades:change-me-db-password@127.0.0.1:5432/libregrades

# Redis / Celery — Docker Compose uses host "redis"
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Email alerts (district SMTP relay)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=libregrades@example.org
EMAIL_USE_TLS=True

# JWT (optional override; defaults derived from SECRET_KEY)
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
